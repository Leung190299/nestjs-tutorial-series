# DB demo cục bộ cho lô 4 phỏng vấn DB — KHÔNG phải secret thật, cố ý commit vào repo
# để người xem clone về là chạy được ngay. Container: dbqa-pg (docker-compose -p dbqa).
# Cổng 5433 (KHÔNG phải 5432) để không đụng Postgres nào khác trên máy.
DATABASE_URL="postgres://dbqa:dbqa@localhost:5433/dbqa"
