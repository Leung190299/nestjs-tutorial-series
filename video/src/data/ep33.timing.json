      "id": "scene-03",
      "type": "code",
      "visual": {
        "filename": "com/vietsuper/host/MiniAppLauncher.kt (attachHostChannel)",
        "language": "kotlin",
        "code": "    private fun attachHostChannel(engine: FlutterEngine) {\n        MethodChannel(engine.dartExecutor.binaryMessenger, \"vietsuper/host\")\n            .setMethodCallHandler { call, result ->\n                when (call.method) {\n                    \"getUserInfo\" ->\n                        result.success(mapOf(\"name\" to \"Lee\", \"balance\" to 1_250_000))\n                    \"close\" -> {\n                        MiniActivity.current?.finish()\n                        result.success(null)\n                    }\n                    else -> result.notImplemented()\n                }\n            }\n    }",
