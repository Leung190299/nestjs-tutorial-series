        "title": "Controlled vs Uncontrolled là gì",
        "bullets": [
          {
            "icon": "🎛️",
            "text": "Controlled: React state giữ giá trị — input chỉ hiển thị đúng state",
            "sentence": 0
          },
          {
            "icon": "🔄",
            "text": "value + onChange: mỗi lần gõ là một vòng render, React luôn biết giá trị hiện tại",
            "sentence": 1
          },
          {
            "icon": "🗄️",
            "text": "Uncontrolled: DOM tự giữ giá trị — React không theo dõi từng ký tự gõ",
            "sentence": 2
          },
          {
            "icon": "🔍",
            "text": "Đọc giá trị qua `ref` khi cần — không tự động đồng bộ theo từng lần gõ",
            "sentence": 3
          }
        ]
