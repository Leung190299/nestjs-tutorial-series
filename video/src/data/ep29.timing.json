      "id": "scene-03",
      "type": "code",
      "visual": {
        "filename": "mini_flutter/lib/wallet_screen.dart (_loadUser)",
        "language": "clike",
        "code": "  Future<void> _loadUser() async {\n    try {\n      final info = await hostChannel.invokeMapMethod<String, Object?>('getUserInfo');\n      if (!mounted) return;\n      setState(() {\n        _name = info?['name'] as String? ?? 'Khách';\n        _balance = (info?['balance'] as num?)?.toInt() ?? 0;\n        _fromHost = true;\n      });\n    } on MissingPluginException {\n      if (!mounted) return;\n      setState(() {\n        _name = 'Khách chạy lẻ';\n        _balance = 500000;\n        _fromHost = false;\n      });\n    }\n  }",
