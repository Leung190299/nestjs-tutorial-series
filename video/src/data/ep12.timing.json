        "filename": "src/users.proto",
        "language": "clike",
        "code": "syntax = \"proto3\";\n\npackage users;\n\nservice UsersService {\n  rpc FindAll (Empty) returns (UserList);\n}\n\nmessage Empty {}\n\nmessage User {\n  int32 id = 1;\n  string name = 2;\n}\n\nmessage UserList {\n  repeated User users = 1;\n}",
