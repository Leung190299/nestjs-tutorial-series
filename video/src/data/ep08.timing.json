        "language": "tsx",
        "code": "import {\n  Controller,\n  Get,\n  NotFoundException,\n  Param,\n  UseFilters,\n} from '@nestjs/common';\nimport { HttpExceptionFilter } from './http-exception.filter';\n\n@UseFilters(HttpExceptionFilter)\n@Controller('orders')\nexport class OrdersController {\n  @Get(':id')\n  findOne(@Param('id') id: string) {\n    throw new NotFoundException(`Không tìm thấy đơn hàng ${id}`);\n  }\n}",
