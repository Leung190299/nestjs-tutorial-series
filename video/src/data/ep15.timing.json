      "visual": {
        "filename": "app/(tabs)/index.tsx (component)",
        "language": "tsx",
        "code": "export default function HomeScreen() {\n  return (\n    <View style={styles.container}>\n      <Text style={styles.greeting}>Chào bạn 👋</Text>\n      <Text style={styles.question}>Hôm nay bạn cần gì?</Text>\n      <FlatList\n        data={services}\n        keyExtractor={(item) => item.id}\n        numColumns={3}\n        renderItem={({ item }) =>\n          item.route ? (\n            <Link href={item.route} asChild>\n              <Pressable style={styles.card}>\n                <Text style={styles.emoji}>{item.emoji}</Text>\n                <Text style={styles.label}>{item.label}</Text>\n              </Pressable>\n            </Link>\n          ) : (\n            <Pressable style={[styles.card, styles.disabled]} disabled>\n              <Text style={styles.emoji}>{item.emoji}</Text>\n              <Text style={styles.label}>{item.label}</Text>\n            </Pressable>\n          )\n        }\n      />\n    </View>\n  );\n}",
