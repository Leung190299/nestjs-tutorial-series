        "title": "v-if vs v-show",
        "bullets": [
          {
            "icon": "🔀",
            "text": "v-if: thêm/xóa HẲN khỏi DOM — ẩn là unmount thật, state con (chữ đã gõ) bị hủy",
            "sentence": 0
          },
          {
            "icon": "💸",
            "text": "v-if: chi phí TOGGLE cao (tạo lại mỗi lần), nhưng lazy — hỗ trợ v-else/v-else-if",
            "sentence": 1
          },
          {
            "icon": "👁️",
            "text": "v-show: LUÔN render, tồn tại sẵn trong DOM — toggle chỉ đổi CSS display, state giữ nguyên",
            "sentence": 2
          },
          {
            "icon": "⚡",
            "text": "v-show: render ban đầu tốn hơn chút, nhưng TOGGLE mỗi lần rất RẺ",
            "sentence": 3
          }
        ]
      },
