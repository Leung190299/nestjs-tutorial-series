      "visual": {
        "title": "Fact sheet: local zero-cost vs cross-file minimal-cost",
        "bullets": [
          {
            "icon": "⚡",
            "text": "Local (cùng file create()) — ZERO runtime cost, compiler inline sẵn",
            "sentence": 0
          },
          {
            "icon": "🧬",
            "text": "props(styles.red) → {className: 'x1e2n...'} tĩnh ngay lúc build",
            "sentence": 1
          },
          {
            "icon": "📦",
            "text": "Cross-file qua prop — compiler giữ object mapping key → className",
            "sentence": 2
          },
          {
            "icon": "⏱️",
            "text": "Resolve lúc RUNTIME — nhỏ hơn hẳn CSS-in-JS truyền thống",
            "sentence": 3
          },
          {
            "icon": "🤝",
            "text": "Đánh đổi hợp lý: 'minimal cost', không phải 'no cost'",
            "sentence": 4
          }
        ]
      },
