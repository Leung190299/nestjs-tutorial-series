        "language": "tsx",
        "code": "// interceptor ôm CẢ 2 CHIỀU handler\nintercept(ctx, next) {\n  const t0 = Date.now(); // trước\n  // next.handle() = Observable LAZY\n  return next.handle().pipe(\n    map((data) => {\n      const tookMs = Date.now() - t0;\n      ctx.switchToHttp().getResponse()\n        .setHeader('X-Response-Time',\n          `${tookMs}ms`);\n      return { ok: true, data, tookMs };\n    }),\n  );\n}",
