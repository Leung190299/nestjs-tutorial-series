    {
      "id": "scene-03b",
      "type": "code",
      "visual": {
        "filename": "s4.controller.ts — TOÀN BỘ FILE",
        "language": "tsx",
        "code": "import { Body, Controller, Post, UsePipes, ValidationPipe } from '@nestjs/common';\nimport { CreateOrderDto } from './create-order.dto.js';\n\n// ValidationPipe scope controller: Nest chèn pipe NGAY TRƯỚC khi method được\n// gọi — body sai là pipe ném exception → 400, handler KHÔNG BAO GIỜ chạy.\n// whitelist: true → gọt sạch mọi property không có decorator (field lạ không lọt).\n// transform: true → body thành instance CreateOrderDto thật.\n@Controller('s4')\n@UsePipes(new ValidationPipe({ whitelist: true, transform: true }))\nexport class S4Controller {\n  // POST /s4 — vào được đến đây nghĩa là body ĐÃ hợp lệ và ĐÃ được gọt sạch.\n  @Post()\n  create(@Body() body: CreateOrderDto) {\n    return { ok: true, order: body };\n  }\n}",
        "steps": [
          {
            "from": 1,
            "to": 9,
            "sentence": 0
          },
          {
            "from": 10,
            "to": 16,
            "sentence": 1
          }
        ]
      },
